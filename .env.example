# Copie este arquivo para ".env" (ou defina como variáveis de ambiente do sistema)
# e preencha com os valores reais. O ".env" nunca deve ser commitado.

# URL base da sua instância Coupa (ex: https://minhaempresa.coupahost.com)
COUPA_BASE_URL=https://sua-instancia.coupahost.com

# Chave usada para criptografar campos sensíveis em coupa_profiles.json.
# Defina um valor único e não compartilhe. Se você mudar esse valor depois
# de já ter perfis salvos, os campos criptografados antigos deixam de
# descriptografar - basta reabrir o perfil e salvar de novo.
COUPA_FW_SECRET=defina-um-valor-forte-aqui

# Opcional - caminhos dos arquivos de mapeamento, se diferentes do padrão
# MAP_FORNECEDORES=C:\caminho\para\mapeamento_fornecedores.xlsx
# MAP_UNIDADES=C:\caminho\para\mapeamento_unidades.xlsx
# MAP_SOLICITANTES=C:\caminho\para\mapeamento_solicitantes.xlsx
